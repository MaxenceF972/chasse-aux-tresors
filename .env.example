# Domaine canonique gravé sur les puces NFC/QR (défaut : https://toyah-games.app)
# NEXT_PUBLIC_APP_URL=https://toyah-games.app

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Notifications push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# Optionnel : application directe de supabase/setup.sql via npm run db:apply
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:[DB_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Fermeture automatique du soir (réglage « auto_close » d'une partie) : le cron
# Vercel (vercel.json) appelle /api/cron/close-day avec ce secret. Une valeur
# longue et aléatoire, posée aussi dans Vercel → Settings → Environment Variables.
CRON_SECRET=YOUR_RANDOM_SECRET
